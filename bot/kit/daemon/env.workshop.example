# .env.workshop — секреты демона поллера. Скопируйте в .env.workshop рядом с docker-compose,
# права 600, в git НЕ коммитить. Заполняет заказчик сам (вендор значений не видит).
WORKSHOP_TG_BOT_TOKEN=
WORKSHOP_FORGE_TOKEN=
# Необязательно (D20 T4): ключ ПИСАТЕЛЯ хранилища вложений — только если в .workshop/storage.yaml настроена привязка
# (имена — реестр секретов install-steps.yaml; пустые значения = хранилище не настроено для демона).
WORKSHOP_S3_ACCESS_KEY_ID=
WORKSHOP_S3_SECRET_ACCESS_KEY=
