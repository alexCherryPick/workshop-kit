   "x-meanings": {
    "in-git": "по пути байты (не указатель этой главы и не указатель LFS); хранилище не участвует",
    "lfs-unsupported": "по пути указатель Git LFS (lfs.signature_prefix); адаптер не действует; клиент показывает «формат LFS не поддерживается»",
    "not-stored": "unsaved; объекта не ждут; отдаются reason и source",
    "object-missing": "stored; объекта нет",
    "ok": "stored или pending; объект есть, size и sha256 совпали",
    "pending-upload": "pending; объекта нет — ещё не загружено, не дефект",
    "pointer-invalid": "сигнатура указателя; первая строка не проходит pointer.first_line_pattern, либо версия 1 и грамматика не выполнена; адаптер не действует",
    "pointer-version-unknown": "первая строка проходит pointer.first_line_pattern, версия не из pointer.known_versions; адаптер не действует",
    "sha-mismatch": "размер равен, sha256 не совпал",
    "size-mismatch": "объект есть, размер не равен size",
    "storage-denied": "привязка есть, ключи отвергнуты; повтор не поможет",
    "storage-not-configured": "stored или pending, привязки нет",
    "storage-unavailable": "сеть, таймаут, отказ хранилища 5xx, обрыв тела ответа при GET (не size-mismatch), отсутствующий бакет — 404 NoSuchBucket, деталь no-such-bucket (бакет — свойство привязки и инфраструктуры, а не ключа); повтор, в том числе после исправления привязки, может помочь",
    "withdrawn": "withdrawn; объекта не ждут; отдаётся reason"
   }
  },
